<style>
#irefresh {
cursor: pointer;
}
#irefresh:hover {

filter: invert(25%) sepia(97%) saturate(2026%) hue-rotate(201deg) brightness(91%) contrast(98%);

}
.ablue {

filter: invert(25%) sepia(97%) saturate(2026%) hue-rotate(201deg) brightness(91%) contrast(98%);

}
.agray {
filter: invert(94%) sepia(0%) saturate(7471%) hue-rotate(37deg) brightness(91%) contrast(87%);
}
.picon {
cursor: pointer;
vertical-align: top;
margin-right: 10px;

}
.picon:hover {

filter: invert(25%) sepia(97%) saturate(2026%) hue-rotate(201deg) brightness(91%) contrast(98%);

}

