<img style="margin-right:10px;" id="irefresh" title="Autorefresh" onclick="chauto()" class="ablue" src="./uml_diagram_files/svgrepo-refresh.svg" width="20" height="20">



<button style="margin-right:15px; vertical-align:top;" onclick="compress(GID('inflated').value,'/uml/')">Submit</button>
